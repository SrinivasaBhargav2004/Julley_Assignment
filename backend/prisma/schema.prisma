generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Core Hierarchy: Organization -> Tenants (Branches) -> Boards
// -------------------------------------------------------------

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenants     Tenant[]
  memberships Membership[]

  @@map("organizations")
}

model Tenant {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  code           String       // E.g., "HQ-SF", "LDN-RND", "TKO-LAB"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  boards         Board[]
  columns        Column[]
  tasks          Task[]
  activityLogs   ActivityLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("tenants")
}

// -------------------------------------------------------------
// Identity & RBAC: Users & Tenant/Org Memberships
// -------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships  Membership[]
  createdTasks Task[]        @relation("TaskCreator")
  assignedTasks Task[]       @relation("TaskAssignee")
  activityLogs ActivityLog[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  tenantId       String?      // Nullable: Org Admins have org-wide authority over all tenants
  role           String       // "ORG_ADMIN" | "TENANT_ADMIN" | "MEMBER"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([tenantId])
  @@map("memberships")
}

// -------------------------------------------------------------
// Business Domain: Boards, Columns, Tasks, Activity Logs
// Strict Tenant Scoping: All business entities hold tenantId
// -------------------------------------------------------------

model Board {
  id           String        @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  columns      Column[]
  tasks        Task[]
  activityLogs ActivityLog[]

  @@index([tenantId])
  @@map("boards")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  tenantId  String   // Tenant isolation verification
  title     String
  position  Float    // Fractional indexing
  color     String?  @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId, position])
  @@index([tenantId])
  @@map("columns")
}

model Task {
  id          String        @id @default(uuid())
  columnId    String
  boardId     String
  tenantId    String        // Tenant isolation verification
  title       String
  description String?
  priority    String        @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  position    Float         // Fractional indexing for O(1) reordering without table-wide locks
  assigneeId  String?
  dueDate     DateTime?
  version     Int           @default(1) // Optimistic Concurrency Control (OCC) version
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  column      Column        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User          @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@index([columnId, position])
  @@index([boardId])
  @@index([tenantId])
  @@map("tasks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  tenantId  String
  boardId   String?
  taskId    String?
  userId    String
  action    String   // "TASK_CREATED" | "TASK_UPDATED" | "TASK_MOVED" | "TASK_DELETED" | "COLUMN_CREATED" | etc.
  details   String   // JSON string with before/after state, diffs, comments
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([boardId])
  @@index([taskId])
  @@map("activity_logs")
}
